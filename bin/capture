#!/usr/bin/env bash

set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$REPO_ROOT/lib/common.sh"
# shellcheck disable=SC1091
. "$REPO_ROOT/lib/state.sh"
# shellcheck disable=SC1091
. "$REPO_ROOT/lib/choices.sh"
# shellcheck disable=SC1091
. "$REPO_ROOT/lib/apps.sh"
# shellcheck disable=SC1091
. "$REPO_ROOT/lib/config.sh"

SOURCE_DIR="${VEDUP_AUTHOR_REPO:-}"
AUTHOR_REPO=""
CAPTURE_WORKTREE=""
CAPTURE_SCOPE=optional
CAPTURE_SCOPE_EXPLICIT=0
CAPTURE_ALL=0
CAPTURE_PUBLISH=0
CAPTURE_DRY_RUN=0
CAPTURE_TMP="$(mktemp -d "${TMPDIR:-/tmp}/vedup-capture.XXXXXX")"
CANDIDATES="$CAPTURE_TMP/candidates.tsv"
SELECTED="$CAPTURE_TMP/selected.tsv"
SAFE_CANDIDATES="$CAPTURE_TMP/safe.tsv"
RECOMMENDED_APPS="$CAPTURE_TMP/recommended-apps.tsv"
: > "$CANDIDATES"
: > "$SELECTED"
: > "$SAFE_CANDIDATES"
: > "$RECOMMENDED_APPS"

cleanup() {
  if [ -n "$CAPTURE_WORKTREE" ] && [ -n "$AUTHOR_REPO" ] && [ -d "$AUTHOR_REPO/.git" ]; then
    git -C "$AUTHOR_REPO" worktree remove --force "$CAPTURE_WORKTREE" >/dev/null 2>&1 || true
  fi
  case "$CAPTURE_TMP" in "${TMPDIR:-/tmp}"/vedup-capture.*) rm -rf "$CAPTURE_TMP" ;; esac
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
Usage: vedup save [options]

  --source DIR              Author checkout (default: Vedup's private author checkout)
  --scope workstation|optional
                            Where newly captured applications belong
  --all                     Select every safe discovered change
  --publish                 Push the branch and open a draft PR for human review
  --dry-run                 Show capturable changes without modifying a checkout
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --source) [ "$#" -ge 2 ] || die "--source requires a directory"; SOURCE_DIR="$2"; shift 2 ;;
    --scope) [ "$#" -ge 2 ] || die "--scope requires a value"; CAPTURE_SCOPE="$2"; CAPTURE_SCOPE_EXPLICIT=1; shift 2 ;;
    --all) CAPTURE_ALL=1; shift ;;
    --publish) CAPTURE_PUBLISH=1; shift ;;
    --dry-run) CAPTURE_DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown capture option: $1" ;;
  esac
done
case "$CAPTURE_SCOPE" in workstation|optional) ;; *) die "--scope must be workstation or optional" ;; esac

capture_prompt() {
  local prompt="$1" answer
  [ "$CAPTURE_ALL" = 1 ] && return 0
  printf '%s [y/N] ' "$prompt" >/dev/tty
  IFS= read -r answer </dev/tty || answer=""
  case "$answer" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

capture_add_candidate() {
  local kind="$1" status="$2" identifier="$3" label="$4" detail="${5:-}"
  label="${label//$'\t'/ }" detail="${detail//$'\t'/ }"
  printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$status" "$identifier" "$label" "$detail" >> "$CANDIDATES"
}

capture_discover_apps() {
  local identifier label qualified
  [ "$STATE_PLATFORM" = macos ] || return 0
  if command -v brew >/dev/null 2>&1; then
    while IFS= read -r identifier; do
      [ -n "$identifier" ] || continue
      apps_manifest_installs cask "$identifier" || {
        qualified="$(capture_brew_identifier cask "$identifier" || true)"
        if [ -z "$qualified" ]; then :
        elif [[ "$qualified" == */* ]] && ! apps_third_party_allowed cask "$qualified"; then
          capture_add_candidate blocked added "cask:$qualified" "$identifier" "Third-party tap is not explicitly trusted by Vedup"
        else capture_add_candidate app added "cask:$qualified" "$identifier" "Homebrew cask"; fi
      }
    done < <(brew list --cask 2>/dev/null || true)
    while IFS= read -r identifier; do
      [ -n "$identifier" ] || continue
      case "$identifier" in git|stow|tmux|btop|eza|fd|git-delta) continue ;; esac
      apps_manifest_installs formula "$identifier" || {
        qualified="$(capture_brew_identifier formula "$identifier" || true)"
        if [ -z "$qualified" ]; then :
        elif [[ "$qualified" == */* ]] && ! apps_third_party_allowed formula "$qualified"; then
          capture_add_candidate blocked added "formula:$qualified" "$identifier" "Third-party tap is not explicitly trusted by Vedup"
        else capture_add_candidate app added "formula:$qualified" "$identifier" "Homebrew formula"; fi
      }
    done < <(brew leaves 2>/dev/null || true)
  fi
  if command -v mas >/dev/null 2>&1; then
    while read -r identifier label; do
      [ -n "$identifier" ] || continue
      apps_manifest_has mas "$identifier" || capture_add_candidate app added "mas:$identifier" "${label:-App Store $identifier}" "Mac App Store"
    done < <(mas list 2>/dev/null || true)
  fi
}

capture_brew_identifier() {
  local provider="$1" token="$2" tap
  if ! command -v jq >/dev/null 2>&1; then
    warn "Skipping untracked Homebrew item $token because jq is unavailable to verify its tap."
    return 1
  fi
  case "$provider" in
    formula) tap="$(brew info --json=v2 --formula "$token" 2>/dev/null | jq -er '.formulae[0].tap')" || return 1 ;;
    cask) tap="$(brew info --json=v2 --cask "$token" 2>/dev/null | jq -er '.casks[0].tap')" || return 1 ;;
    *) return 1 ;;
  esac
  case "$tap" in
    homebrew/core|homebrew/cask) printf '%s' "$token" ;;
    [A-Za-z0-9_.-]*/[A-Za-z0-9_.-]*) printf '%s/%s' "$tap" "$token" ;;
    *) warn "Skipping $token because Homebrew reported an unsafe tap identity: $tap"; return 1 ;;
  esac
}

capture_discover_config() {
  local status path source
  while IFS=$'\t' read -r status path; do
    source="$VEDUP_CONFIG_WORKTREE/$path"
    if [ "$status" != deleted ] && ! config_path_is_safe_to_capture "$path" "$source"; then
      capture_add_candidate blocked "$status" "$path" "$path" "Possible secret or machine-local data"
    else
      capture_add_candidate config "$status" "$path" "$path" "Managed configuration"
    fi
  done < <(config_capture_changes)
}

capture_normalize_preference() {
  local value_type="$1" value="$2"
  case "$value_type:$value" in
    -bool:1|-bool:true|-bool:TRUE|-bool:Yes) printf true ;;
    -bool:0|-bool:false|-bool:FALSE|-bool:No) printf false ;;
    *) printf '%s' "$value" ;;
  esac
}

capture_discover_preferences() {
  local settings_file relative domain key value_type desired current normalized
  [ "$STATE_PLATFORM" = macos ] && command -v defaults >/dev/null 2>&1 || return 0
  for settings_file in "$REPO_ROOT/dotfiles/macos/settings/core.sh" "$REPO_ROOT/dotfiles/macos/settings/experimental.sh"; do
    [[ "$settings_file" != *experimental.sh ]] || [ "$STATE_EXPERIMENTAL_MACOS_DEFAULTS" = 1 ] || continue
    relative="${settings_file#"$REPO_ROOT"/}"
    while read -r _ domain key value_type desired extra; do
      [ -z "${extra:-}" ] || continue
      current="$(defaults read "$domain" "$key" 2>/dev/null || true)"
      [ -n "$current" ] || continue
      normalized="$(capture_normalize_preference "$value_type" "$current")"
      [ "$normalized" = "$desired" ] && continue
      capture_add_candidate preference modified "$relative|$domain|$key|$value_type" "$domain $key" "$desired → $normalized"
    done < <(awk '$1 == "macos_defaults" { print }' "$settings_file")
  done
}

state_load "$VEDUP_STATE_FILE" || die "Run Vedup Safe sync once before capturing local changes."
choices_load_or_default || die "Saved application choices are invalid."
PROFILE="$STATE_PROFILE" WITH_PERSONAL_APPS="$STATE_WITH_PERSONAL_APPS"
read -r -a STOW_PACKAGES <<< "$STATE_STOW_PACKAGES"
if [ ! -d "$VEDUP_CONFIG_BASE" ] || [ ! -d "$VEDUP_CONFIG_WORKTREE" ]; then
  die "The writable configuration workspace is not initialized. Run 'vedup sync' with this release first."
fi

capture_discover_apps
capture_discover_config
capture_discover_preferences

if [ ! -s "$CANDIDATES" ]; then
  printf 'Vedup save: no local application, configuration, or tracked preference changes were found.\n'
  exit 0
fi

printf 'Vedup save — local changes found\n\n'
candidate_index=0
while IFS=$'\t' read -r kind status identifier label detail; do
  if [ "$kind" = blocked ]; then
    printf '  ⚠ EXCLUDED  %-10s %s (%s)\n' "$status" "$label" "$detail"
    continue
  fi
  candidate_index=$((candidate_index + 1))
  printf '  %2s) %-10s %-10s %s — %s\n' "$candidate_index" "$kind" "$status" "$label" "$detail"
  printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$status" "$identifier" "$label" "$detail" >> "$SAFE_CANDIDATES"
done < "$CANDIDATES"

[ "$CAPTURE_DRY_RUN" = 0 ] || exit 0
if [ "$CAPTURE_ALL" = 1 ]; then
  cp "$SAFE_CANDIDATES" "$SELECTED"
else
  printf '\nEnter comma-separated numbers to save, or press Enter to cancel: ' >/dev/tty
  IFS= read -r selected_numbers </dev/tty || selected_numbers=""
  [ -n "$selected_numbers" ] || { printf '\nNo changes selected.\n'; exit 0; }
  selected_seen=""
  while IFS= read -r selected_number; do
    case "$selected_number" in ''|*[!0-9]*) die "Selections must be comma-separated numbers." ;; esac
    if [ "$selected_number" -lt 1 ] || [ "$selected_number" -gt "$candidate_index" ]; then
      die "Selection $selected_number is outside the available range."
    fi
    case " $selected_seen " in *" $selected_number "*) continue ;; esac
    selected_seen="$selected_seen $selected_number"
    sed -n "${selected_number}p" "$SAFE_CANDIDATES" >> "$SELECTED"
  done < <(printf '%s\n' "$selected_numbers" | tr ',' '\n')
fi
[ -s "$SELECTED" ] || { printf '\nNo changes selected.\n'; exit 0; }

if [ "$CAPTURE_ALL" != 1 ] && [ "$CAPTURE_SCOPE_EXPLICIT" != 1 ] && awk -F '\t' '$1 == "app" { found=1 } END { exit !found }' "$SELECTED"; then
  printf '\nNew applications are Optional by default.\n'
  app_index=0
  while IFS=$'\t' read -r kind status identifier label detail; do
    [ "$kind" = app ] || continue
    app_index=$((app_index + 1))
    printf '  %s) %s\n' "$app_index" "$label"
    printf '%s\t%s\n' "$app_index" "$identifier" >> "$CAPTURE_TMP/app-index.tsv"
  done < "$SELECTED"
  printf 'Enter app numbers that should join Recommended Apps, or press Enter for none: ' >/dev/tty
  IFS= read -r recommended_numbers </dev/tty || recommended_numbers=""
  if [ -n "$recommended_numbers" ]; then
    while IFS= read -r recommended_number; do
      case "$recommended_number" in ''|*[!0-9]*) die "App selections must be comma-separated numbers." ;; esac
      identifier="$(awk -F '\t' -v wanted="$recommended_number" '$1 == wanted { print $2; exit }' "$CAPTURE_TMP/app-index.tsv")"
      [ -n "$identifier" ] || die "Application selection $recommended_number is outside the available range."
      grep -Fxq "$identifier" "$RECOMMENDED_APPS" 2>/dev/null || printf '%s\n' "$identifier" >> "$RECOMMENDED_APPS"
    done < <(printf '%s\n' "$recommended_numbers" | tr ',' '\n')
  fi
fi

if [ "$CAPTURE_ALL" != 1 ]; then
  selected_count="$(wc -l < "$SELECTED" | tr -d ' ')"
  capture_prompt "Save $selected_count selected change(s) for future machines?" || { printf 'Nothing was saved.\n'; exit 0; }
  CAPTURE_PUBLISH=1
fi

if [ -z "$SOURCE_DIR" ]; then SOURCE_DIR="$VEDUP_CONFIG_ROOT/author-repo"; fi
AUTHOR_REPO="$SOURCE_DIR"
if [ ! -d "$AUTHOR_REPO/.git" ]; then
  [ ! -e "$AUTHOR_REPO" ] || die "Author checkout path exists but is not a Git repository: $AUTHOR_REPO"
  mkdir -p "$(dirname "$AUTHOR_REPO")"
  capture_repository="$(vedup_repository)" || die "Vedup's author repository is invalid."
  git clone "https://github.com/${capture_repository}.git" "$AUTHOR_REPO"
fi
[ -z "$(git -C "$AUTHOR_REPO" status --porcelain)" ] || die "Author checkout has uncommitted changes: $AUTHOR_REPO"
git -C "$AUTHOR_REPO" fetch origin --prune --tags
branch="save/$(date -u +%Y%m%d-%H%M%S)"
CAPTURE_WORKTREE="$CAPTURE_TMP/worktree"
git -C "$AUTHOR_REPO" worktree add -b "$branch" "$CAPTURE_WORKTREE" origin/main
SOURCE_DIR="$CAPTURE_WORKTREE"

capture_update_preference() {
  local spec="$1" new_value="$2" relative domain key value_type target temporary shell_value mode
  IFS='|' read -r relative domain key value_type <<< "$spec"
  target="$SOURCE_DIR/$relative" temporary="$CAPTURE_TMP/preference.$$"
  printf -v shell_value '%q' "$new_value"
  awk -v domain="$domain" -v key="$key" -v value_type="$value_type" -v replacement="$shell_value" '
    $1 == "macos_defaults" && $2 == domain && $3 == key && $4 == value_type {
      print $1, $2, $3, $4, replacement; changed=1; next
    }
    { print }
    END { if (!changed) exit 42 }
  ' "$target" > "$temporary" || die "Could not update tracked preference $domain $key"
  if ! mode="$(stat -f '%Lp' "$target" 2>/dev/null)"; then
    mode="$(stat -c '%a' "$target")" || die "Could not read permissions for $relative"
  fi
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die "Could not validate permissions for $relative"
  chmod "$mode" "$temporary"
  mv "$temporary" "$target"
}

while IFS=$'\t' read -r kind status identifier label detail; do
  case "$kind" in
    app)
      provider="${identifier%%:*}" app_id="${identifier#*:}"
      if REPO_ROOT="$SOURCE_DIR" VEDUP_MACOS_APPS_MANIFEST="$SOURCE_DIR/profiles/macos/apps.tsv" \
        bash -c 'source "$REPO_ROOT/lib/apps.sh"; apps_manifest_has "$1" "$2"' _ "$provider" "$app_id"; then
        warn "$label is already present on current main; skipping the duplicate capture."
        continue
      fi
      app_scope="$CAPTURE_SCOPE"
      grep -Fxq "$identifier" "$RECOMMENDED_APPS" 2>/dev/null && app_scope=workstation
      printf '%s\t%s\t%s\t%s\t%s\n' "$app_scope" "$provider" "$app_id" "$label" \
        "Captured intentionally from an existing Vedup machine." >> "$SOURCE_DIR/profiles/macos/apps.tsv"
      ;;
    config)
      source="$VEDUP_CONFIG_WORKTREE/$identifier" destination="$SOURCE_DIR/dotfiles/$identifier"
      if [ "$status" = deleted ]; then
        rm -f "$destination"
      else
        config_path_is_safe_to_capture "$identifier" "$source" || die "Blocked possible secret: $identifier"
        mkdir -p "$(dirname "$destination")"
        cp "$source" "$destination"
      fi
      ;;
    preference)
      current_value="${detail#* → }"
      capture_update_preference "$identifier" "$current_value"
      ;;
  esac
done < "$SELECTED"

apps_manifest_validate_file "$SOURCE_DIR/profiles/macos/apps.tsv" || die "Capture produced an invalid or duplicate application manifest."
git -C "$SOURCE_DIR" diff --check
"$REPO_ROOT/scripts/scan-secrets" --repo "$SOURCE_DIR" --current
printf '\nProposed repository change:\n'
git -C "$SOURCE_DIR" diff --stat

(cd "$SOURCE_DIR" && VEDUP_CAPTURE_VALIDATION=1 ./tests/test.sh)
git -C "$SOURCE_DIR" add -- profiles/macos/apps.tsv dotfiles
"$REPO_ROOT/scripts/scan-secrets" --repo "$SOURCE_DIR" --staged
git -C "$SOURCE_DIR" commit -m "Save local Vedup intent"

if [ "$CAPTURE_PUBLISH" != 1 ]; then
  printf 'Saved local commit on %s in %s.\n' "$branch" "$AUTHOR_REPO"
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  printf 'GitHub CLI is unavailable, so the validated change was saved locally on %s.\n' "$branch" >&2
  [ "$CAPTURE_ALL" != 1 ] || exit 1
  exit 0
fi
if ! gh auth status >/dev/null 2>&1; then
  if [ "$CAPTURE_ALL" != 1 ] && capture_prompt "Connect GitHub now to make these changes permanent?"; then
    gh auth login
  else
    printf 'GitHub is not connected. The validated change remains local on %s.\n' "$branch" >&2
    [ "$CAPTURE_ALL" != 1 ] || exit 1
    exit 0
  fi
fi
git -C "$SOURCE_DIR" push -u origin "$branch"
pr_url="$(cd "$SOURCE_DIR" && gh pr create --draft --base main --head "$branch" --title "Save local Vedup intent" \
  --body "Saved explicitly selected applications, managed configuration, and tracked macOS preferences. Secrets and machine-local paths were excluded. The full hermetic test suite passed locally.")"
printf 'Draft review opened: %s\n' "$pr_url"
printf 'Vedup never merges or publishes captured changes automatically. Review CI and the diff before merging.\n'
