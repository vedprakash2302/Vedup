#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GITLEAKS_VERSION="8.30.1"
SCAN_MODE="all"
SCAN_REPO="$SCRIPT_ROOT"

usage() {
  cat <<'EOF'
Usage: scripts/scan-secrets [--all|--history|--current|--staged] [--repo DIR]

Downloads the pinned Gitleaks binary into Vedup's user cache after verifying
its SHA-256 checksum. Suspected values are always fully redacted.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --all) SCAN_MODE=all; shift ;;
    --history) SCAN_MODE=history; shift ;;
    --current) SCAN_MODE=current; shift ;;
    --staged) SCAN_MODE=staged; shift ;;
    --repo) [ "$#" -ge 2 ] || { printf 'Missing value for --repo\n' >&2; exit 2; }; SCAN_REPO="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

git -C "$SCAN_REPO" rev-parse --git-dir >/dev/null 2>&1 || { printf 'Not a Git repository: %s\n' "$SCAN_REPO" >&2; exit 2; }

checksum_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else printf 'A SHA-256 implementation is required.\n' >&2; return 1
  fi
}

platform="$(uname -s)-$(uname -m)"
case "$platform" in
  Linux-x86_64|Linux-amd64)
    asset="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
    expected="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
    ;;
  Linux-aarch64|Linux-arm64)
    asset="gitleaks_${GITLEAKS_VERSION}_linux_arm64.tar.gz"
    expected="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
    ;;
  Darwin-arm64|Darwin-aarch64)
    asset="gitleaks_${GITLEAKS_VERSION}_darwin_arm64.tar.gz"
    expected="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
    ;;
  Darwin-x86_64|Darwin-amd64)
    asset="gitleaks_${GITLEAKS_VERSION}_darwin_x64.tar.gz"
    expected="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"
    ;;
  *) printf 'Unsupported secret-scanner platform: %s\n' "$platform" >&2; exit 1 ;;
esac

cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/vedup/security/gitleaks/$GITLEAKS_VERSION"
scanner="$cache_root/gitleaks"
if [ ! -x "$scanner" ] || [ "$($scanner version 2>/dev/null || true)" != "$GITLEAKS_VERSION" ]; then
  command -v curl >/dev/null 2>&1 || { printf 'curl is required to obtain the pinned secret scanner.\n' >&2; exit 1; }
  temporary="$(mktemp -d "${TMPDIR:-/tmp}/vedup-gitleaks.XXXXXX")"
  trap 'rm -rf -- "${temporary:-}"' EXIT INT TERM
  archive="$temporary/$asset"
  curl --fail --silent --show-error --location --retry 3 --retry-delay 1 \
    --proto '=https' --tlsv1.2 \
    "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${asset}" \
    --output "$archive"
  [ "$(checksum_file "$archive")" = "$expected" ] || {
    printf 'Gitleaks checksum mismatch; no scan was run.\n' >&2
    exit 1
  }
  tar -xzf "$archive" -C "$temporary" gitleaks
  [ -x "$temporary/gitleaks" ] || chmod 0755 "$temporary/gitleaks"
  mkdir -p "$cache_root"
  chmod 0700 "$cache_root"
  install -m 0755 "$temporary/gitleaks" "$cache_root/.gitleaks.new.$$"
  mv "$cache_root/.gitleaks.new.$$" "$scanner"
  rm -rf -- "$temporary"
  trap - EXIT INT TERM
fi

common=(--redact=100 --no-banner --no-color --timeout 180)
case "$SCAN_MODE" in
  history) (cd "$SCAN_REPO" && "$scanner" git "${common[@]}" --log-opts='--all' .) ;;
  current) (cd "$SCAN_REPO" && "$scanner" dir "${common[@]}" .) ;;
  staged) (cd "$SCAN_REPO" && "$scanner" git "${common[@]}" --pre-commit --staged .) ;;
  all)
    (cd "$SCAN_REPO" && "$scanner" git "${common[@]}" --log-opts='--all' .)
    (cd "$SCAN_REPO" && "$scanner" dir "${common[@]}" .)
    ;;
esac

printf 'Secret scan passed (%s).\n' "$SCAN_MODE"
