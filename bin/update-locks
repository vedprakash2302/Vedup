#!/usr/bin/env bash

set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v mise >/dev/null 2>&1 || { printf 'mise is required to update locks.\n' >&2; exit 1; }

cd "$REPO_ROOT"
mise lock --platform linux-x64 --platform linux-arm64 --platform macos-x64 --platform macos-arm64
printf 'Updated mise.lock. Review upstream checksums and run ./tests/test.sh before committing.\n'
