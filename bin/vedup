#!/usr/bin/env bash

set -Eeuo pipefail

# Resolve older symlink launchers before deriving the release root. Bash sets
# BASH_SOURCE to the path used to invoke a script, so calculating the parent of
# ~/.local/bin/vedup otherwise incorrectly treats ~/.local as the repository.
script_source="${BASH_SOURCE[0]}"
while [ -L "$script_source" ]; do
  script_dir="$(cd -P "$(dirname "$script_source")" && pwd)"
  script_target="$(readlink "$script_source")"
  case "$script_target" in
    /*) script_source="$script_target" ;;
    *) script_source="$script_dir/$script_target" ;;
  esac
done
REPO_ROOT="$(cd -P "$(dirname "$script_source")/.." && pwd)"
if [ "$#" -eq 0 ]; then exec "$REPO_ROOT/bin/install" --home; fi
command_name="$1"
shift
case "$command_name" in
  sync|install)
    if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then exec "$REPO_ROOT/bin/install"
    else exec "$REPO_ROOT/bin/setup" "$@"; fi
    ;;
  customize) exec "$REPO_ROOT/bin/install" --customize "$@" ;;
  update|upgrade) exec "$REPO_ROOT/bin/update" "$@" ;;
  save|capture) exec "$REPO_ROOT/bin/capture" "$@" ;;
  apps)
    [ "${1:-}" = update ] || { printf 'Usage: vedup apps update\n' >&2; exit 2; }
    shift
    exec "$REPO_ROOT/bin/install" --apps-update "$@"
    ;;
  advanced) exec "$REPO_ROOT/bin/install" --advanced "$@" ;;
  status) exec "$REPO_ROOT/bin/status" "$@" ;;
  doctor) exec "$REPO_ROOT/bin/doctor" "$@" ;;
  help|-h|--help)
    if [ "${1:-}" = --automation ]; then exec "$REPO_ROOT/bin/setup" --help; fi
    printf '%s\n' \
      'Usage: vedup [command]' '' \
      "Run \`vedup\` without arguments for the friendly menu." '' \
      '  sync         Synchronize this machine' \
      '  customize    Change selected components' \
      '  update       Download, verify, and activate the latest Vedup release' \
      '  save         Save local changes for future machines' \
      '  apps update  Review GUI application updates' \
      '  doctor       Diagnose the active installation' \
      '  advanced     Manage high-impact macOS settings' '' \
      'Automation flags: vedup help --automation'
    ;;
  *) printf 'Unknown Vedup command: %s\n' "$command_name" >&2; exit 2 ;;
esac
